#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Student {
    int roll;
    char name[50];
    int marks;
    struct Student *next;
};

struct Student *head = NULL;   // head of linked list

void addStudent();
void displayStudents();
void searchStudent();
void updateStudent();
void deleteStudent();
void adminMenu();
void userMenu();
int loginSystem();

int main() {
    int role = loginSystem();

    if (role == 1)
        adminMenu();
    else if (role == 2)
        userMenu();
    else
        printf("Invalid Login. Exiting...\n");

    return 0;
}

int loginSystem() {
    char user[30], pass[30];

    printf("\n-----------------------------\n");
    printf(" LOGIN SYSTEM - SRMS\n");
    printf("-----------------------------\n");
    printf("Enter Username: ");
    scanf("%s", user);
    printf("Enter Password: ");
    scanf("%s", pass);

    // hardcoded credentials
    if (strcmp(user, "admin") == 0 && strcmp(pass, "admin123") == 0)
        return 1;   // ADMIN
    if (strcmp(user, "user") == 0 && strcmp(pass, "user123") == 0)
        return 2;   // USER

    return 0;       // invalid
}

void adminMenu() {
    int ch;
    do {
        printf("\n========== ADMIN MENU ==========\n");
        printf("1. Add Student\n");
        printf("2. Display Students\n");
        printf("3. Search Student\n");
        printf("4. Update Student\n");
        printf("5. Delete Student\n");
        printf("6. Exit\n");
        printf("Enter Choice: ");
        scanf("%d", &ch);

        switch (ch) {
            case 1: addStudent();      break;
            case 2: displayStudents(); break;
            case 3: searchStudent();   break;
            case 4: updateStudent();   break;
            case 5: deleteStudent();   break;
            case 6: break;
            default: printf("Invalid choice!\n");
        }
    } while (ch != 6);
}

void userMenu() {
    int ch;
    do {
        printf("\n========== USER MENU ==========\n");
        printf("1. Display Students\n");
        printf("2. Search Student\n");
        printf("3. Exit\n");
        printf("Enter Choice: ");
        scanf("%d", &ch);

        switch (ch) {
            case 1: displayStudents(); break;
            case 2: searchStudent();   break;
            case 3: break;
            default: printf("Invalid choice!\n");
        }
    } while (ch != 3);
}

void addStudent() {
    struct Student *newNode, *temp;
    int roll;
    char name[50];
    int marks;

    newNode = (struct Student *)malloc(sizeof(struct Student));
    if (!newNode) {
        printf("Memory allocation failed!\n");
        return;
    }

    printf("\nEnter Roll Number: ");
    scanf("%d", &roll);

    // check duplicate roll
    temp = head;
    while (temp != NULL) {
        if (temp->roll == roll) {
            printf("Roll number already exists! Cannot add duplicate.\n");
            free(newNode);
            return;
        }
        temp = temp->next;
    }

    printf("Enter Name: ");
    scanf(" %[^\n]", name);
    printf("Enter Marks: ");
    scanf("%d", &marks);

    newNode->roll  = roll;
    strcpy(newNode->name, name);
    newNode->marks = marks;
    newNode->next  = NULL;

    if (head == NULL) {
        head = newNode;
    } else {
        temp = head;
        while (temp->next != NULL)
            temp = temp->next;
        temp->next = newNode;
    }

    printf("Student Added Successfully!\n");
}

void displayStudents() {
    struct Student *temp = head;

    if (head == NULL) {
        printf("No data found.\n");
        return;
    }

    printf("\nROLL\tNAME\t\tMARKS\n");
    printf("---------------------------------\n");

    while (temp != NULL) {
        printf("%d\t%s\t\t%d\n", temp->roll, temp->name, temp->marks);
        temp = temp->next;
    }
}

void searchStudent() {
    int r;
    int found = 0;
    struct Student *temp = head;

    if (head == NULL) {
        printf("No data found.\n");
        return;
    }

    printf("Enter Roll No to Search: ");
    scanf("%d", &r);

    while (temp != NULL) {
        if (temp->roll == r) {
            printf("\nRecord Found!\n");
            printf("Roll: %d\nName: %s\nMarks: %d\n",
                   temp->roll, temp->name, temp->marks);
            found = 1;
            break;
        }
        temp = temp->next;
    }

    if (!found)
        printf("Student Not Found!\n");
}

void updateStudent() {
    int r;
    int found = 0;
    struct Student *temp = head;

    if (head == NULL) {
        printf("No data found.\n");
        return;
    }

    printf("Enter Roll No to Update: ");
    scanf("%d", &r);

    while (temp != NULL) {
        if (temp->roll == r) {
            printf("Enter New Name: ");
            scanf(" %[^\n]", temp->name);
            printf("Enter New Marks: ");
            scanf("%d", &temp->marks);
            found = 1;
            break;
        }
        temp = temp->next;
    }

    if (found)
        printf("Record Updated Successfully!\n");
    else
        printf("Record Not Found!\n");
}

void deleteStudent() {
    int r;
    int found = 0;
    struct Student *temp = head;
    struct Student *prev = NULL;

    if (head == NULL) {
        printf("No data found.\n");
        return;
    }

    printf("Enter Roll No to Delete: ");
    scanf("%d", &r);

    while (temp != NULL) {
        if (temp->roll == r) {
            if (prev == NULL) { // deleting head
                head = temp->next;
            } else {
                prev->next = temp->next;
            }
            free(temp);
            found = 1;
            break;
        }
        prev = temp;
        temp = temp->next;
    }

    if (found)
        printf("Record Deleted!\n");
    else
        printf("Record Not Found!\n");
}
